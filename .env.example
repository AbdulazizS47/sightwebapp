# Copy to .env and fill values

# Authentica OTP (SMS) — used as-is, and as the fallback if WhatsApp delivery below fails
SMS_PROVIDER=authentica
AUTHENTICA_API_KEY=YOUR_AUTHENTICA_KEY
AUTHENTICA_TEMPLATE_ID=1
AUTHENTICA_METHOD=sms
OTP_WEB_ORIGIN=sightcoffeespace.com

# Direct WhatsApp OTP (Meta WhatsApp Business Platform / Cloud API) — optional.
# Leave WHATSAPP_CLOUD_API_TOKEN/WHATSAPP_PHONE_NUMBER_ID/WHATSAPP_OTP_TEMPLATE_NAME unset to
# skip this and use Authentica SMS only. See docs/whatsapp-otp-setup.md.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG_EN=en_US
WHATSAPP_OTP_TEMPLATE_LANG_AR=ar
WHATSAPP_OTP_TEMPLATE_HAS_BUTTON=false
WHATSAPP_GRAPH_API_VERSION=v21.0

# Customer broadcast messages (Admin Dashboard -> Broadcast tab) — optional, reuses the
# WHATSAPP_CLOUD_API_TOKEN/WHATSAPP_PHONE_NUMBER_ID above but needs its own approved
# "Marketing" category template (separate from the OTP one). See docs/whatsapp-otp-setup.md.
WHATSAPP_MARKETING_TEMPLATE_NAME=
WHATSAPP_MARKETING_TEMPLATE_LANG_EN=en_US
WHATSAPP_MARKETING_TEMPLATE_LANG_AR=ar

# OTP controls
OTP_TTL_MS=300000
OTP_RESEND_MIN_MS=60000
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=REPLACE_WITH_LONG_RANDOM_STRING
OTP_DEV_MODE=false

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_DB_PASSWORD
MYSQL_DATABASE=sight_app

# Admin
ADMIN_PHONE=0547444145
ADMIN_TOKEN=OPTIONAL_SERVER_SIDE_TOKEN

# Printing
PRINT_DEVICE_KEY=SET_A_DEVICE_KEY_FOR_PRINT_BRIDGE

# New order notifications (Telegram group chat)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_GROUP_CHAT_ID
# Optional: force provider selection when more providers are added later
ORDER_NOTIFY_PROVIDER=telegram

# Telegram sales agent (owner-only commands + previous-day report)
TELEGRAM_AGENT_ENABLED=false
TELEGRAM_AGENT_CHAT_IDS=YOUR_OWNER_CHAT_ID
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_16_OR_MORE_RANDOM_LETTERS_NUMBERS_UNDERSCORES_OR_HYPHENS
TELEGRAM_DAILY_REPORT_TIME=09:00
PUBLIC_BASE_URL=https://api.example.com
DEFAULT_TIMEZONE=Asia/Riyadh

# Read-only AI operational manager (server-side only)
OPENAI_OPERATIONAL_AGENT_ENABLED=false
OPENAI_API_KEY=YOUR_OPENAI_PROJECT_API_KEY
OPENAI_OPERATIONAL_AGENT_MODEL=gpt-5.6-terra
OPENAI_OPERATIONAL_AGENT_REASONING=medium

# Web security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
